# Скопируйте в .env и заполните значения.
# Секреты не коммитятся: .env указан в .gitignore.

# Окружение: development | production
ENVIRONMENT=development

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# База данных (для запуска вне docker; в docker-compose переопределяется)
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research

# Redis (для запуска вне docker; в docker-compose переопределяется)
REDIS_URL=redis://localhost:6379/0

# Адреса фронтенда, которым разрешены запросы (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Секрет для подписи токенов (не короче 32 символов). В production обязательно задать случайное значение,
# например: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-secret-do-not-use-in-production-0000
# Время жизни access-токена (минуты) и refresh-токена (дни)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Защита от перебора паролей: число неудачных попыток и время блокировки (минуты)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Лимит запросов к эндпоинтам авторизации в минуту с одного IP
AUTH_RATE_LIMIT_PER_MINUTE=20

# Адрес фронтенда — на его страницы ведут ссылки из писем
FRONTEND_URL=http://localhost:5173
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# Срок действия ссылок из писем
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Повторная отправка письма на тот же адрес — не чаще, чем раз в N секунд
EMAIL_RESEND_COOLDOWN_SECONDS=60

# Почта: console — письма выводятся в лог API (для разработки), resend — отправка через Resend
MAIL_BACKEND=console
# В тестовом режиме Resend (без подтверждённого домена) отправитель — только onboarding@resend.dev,
# а получатель — только email владельца аккаунта Resend
MAIL_FROM=Research Platform <onboarding@resend.dev>
RESEND_API_KEY=
